{
  "name": "fontealta-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typegen:extract": "sanity schema extract --path=./sanity/schema.json --force",
    "typegen:generate": "sanity typegen generate",
    "typegen": "pnpm typegen:extract && pnpm typegen:generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:e2e": "NEXT_PUBLIC_E2E=1 FAQ_SITO=1 pnpm build && playwright test -c playwright.regression.config.ts",
    "e2e:firma": "node scripts/e2e-firma.mjs",
    "seed:sprint1": "tsx scripts/seed-sprint-1.ts",
    "migrate:sprint-2-schema": "tsx scripts/migrate-sprint-2-schema.ts",
    "history:index": "node scripts/history-index.mjs",
    "parse:catalog": "tsx scripts/parse-catalog.ts",
    "seed:sprint2": "tsx scripts/seed-sprint-2.ts",
    "purge:finish-drafts": "tsx scripts/purge-finish-drafts.ts",
    "migra:seo-lingua": "tsx scripts/migra-seo-lingua.ts",
    "i18n:export": "tsx scripts/i18n/export-content.ts",
    "i18n:import": "tsx scripts/i18n/import-content.ts",
    "i18n:diff": "tsx scripts/i18n/messages-diff.ts",
    "i18n:discard": "tsx scripts/i18n/discard-content.ts",
    "i18n:publish": "tsx scripts/i18n/publish-content.ts",
    "i18n:cinque-lingue": "node scripts/i18n/cinque-lingue.mjs",
    "faq:carica": "tsx scripts/i18n/faq-carica.ts",
    "faq:doppie": "tsx scripts/i18n/faq-doppie.ts",
    "faq:verifica": "tsx scripts/i18n/faq-carica.ts --verifica",
    "contenuti:carica": "tsx scripts/i18n/contenuti-carica.ts",
    "post:link": "tsx scripts/i18n/post-link.ts",
    "post:carica": "tsx scripts/i18n/contenuti-carica.ts --sezione=post",
    "sanity:attributi": "tsx scripts/sanity/attributi.ts",
    "sanity:export": "sanity datasets export production tmp/backup/production-$(date +%F).tar.gz"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^7.0.2",
    "@portabletext/react": "^6.2.0",
    "@sanity/client": "^7.27.0",
    "@sanity/document-internationalization": "6.2.38",
    "@sanity/image-url": "^2.1.1",
    "@sanity/language-filter": "5.0.18",
    "@sanity/vision": "6.15.0",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "next-sanity": "^13.3.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "sanity": "6.15.0",
    "sanity-plugin-internationalized-array": "5.3.1",
    "styled-components": "^6.6.0",
    "swiper": "^14.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.11",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
