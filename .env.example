# ─────────────────────────────────────────────────────────────────────────────
# Fontealta — environment variables
# Copy this to .env.local and populate. .env.local is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sanity (CMS) ─────────────────────────────────────────────────────────────
# Public values come from `npx sanity@latest init` and end up in the bundle.
NEXT_PUBLIC_SANITY_PROJECT_ID="mwlqc6ab"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# Server-only token for reading drafts (preview mode). Generate at:
# https://www.sanity.io/manage → project → API → Tokens → "Next.js Read Token"
# Permission: Viewer.
SANITY_API_READ_TOKEN=""

# Shared secret used by /api/revalidate to validate Sanity webhook signatures.
# Generate locally: openssl rand -base64 32
# Then paste the same value into Sanity dashboard → API → Webhooks → Secret.
SANITY_REVALIDATE_SECRET=""

# ── Contact form destination (Zapier webhook) ────────────────────────────────
# Server-only. La server action submitContact inoltra le richieste del form a
# questo webhook (POST JSON). Se ASSENTE → dry-run (log + successo simulato, zero
# invii reali) così build/test/CI girano senza segreti. Crea uno Zap con trigger
# "Webhooks by Zapier → Catch Hook" e incolla qui l'URL. NON deve mai arrivare al client.
ZAPIER_CONTACT_WEBHOOK_URL=""
# Segreto condiviso con lo Zap. Viaggia nel BODY del payload come `_secret`, non in un header, perché il
# Catch Hook di Zapier non legge gli header. Facoltativo: se manca, il campo non si manda. Server-only;
# su Vercel solo Production, come il webhook.
ZAPIER_SHARED_SECRET=

# ── Cookie consent (Iubenda) ─────────────────────────────────────────────────
# Sprint 2: customer's existing Iubenda account.
IUBENDA_SITE_ID=""
IUBENDA_COOKIE_POLICY_ID=""
# ⛔ SPENTI in produzione dal 16/09/2026. Il codice resta nel layout, dormiente, legato a queste variabili.
# Impostarle accende un banner e dei cookie che le menzioni legali escludono, e rende falsa la cookie
# policy: si accendono solo insieme a una PR sulle menzioni legali (rule legali-contatti).

# ── Analytics (Plausible) ────────────────────────────────────────────────────
# Sprint 2: https://plausible.io → site setup → bare domain (no scheme).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""


# ── Site URL (used by draft-mode redirects, OG metadata) ─────────────────────
# Optional for local dev (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=""
# Brevo: email del catalogo (src/lib/brevo.ts). Server-only; su Vercel SOLO Production, Sensitive.
# Assente (anteprime, sviluppo): nessun invio, la pagina mostra il link diretto al PDF.

# ── Catalog email (Brevo) ────────────────────────────────────────────────────
# Brevo: email del catalogo (src/lib/brevo.ts). Server-only; su Vercel SOLO Production, Sensitive.
# Assente (anteprime, sviluppo): nessun invio, la pagina mostra il link diretto al PDF.
BREVO_API_KEY=
# Solo e2e (finto Brevo): accettato solo con host localhost o 127.0.0.1. Mai su Vercel.
# BREVO_API_URL=http://127.0.0.1:39

